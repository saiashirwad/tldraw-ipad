{
  "name": "tldraw-ipad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tldraw-ipad": "./scripts/cli.mjs"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "build:ipad": "NODE_ENV=development pnpm build",
    "start": "tsx server.ts --production",
    "check": "tsc --noEmit",
    "test": "node --import tsx scripts/test.ts",
    "test:fast": "node --import tsx --test tests/ask.test.ts tests/question-mark.test.ts tests/runtime.test.ts",
    "test:browser": "node --import tsx scripts/test.ts --browser",
    "verify": "node --import tsx scripts/verify.ts",
    "ipad:dev": "node --import tsx scripts/ipad.ts dev",
    "ipad:reload": "node --import tsx scripts/ipad.ts reload",
    "ipad:stop": "node --import tsx scripts/ipad.ts stop",
    "ipad:verify": "node --import tsx scripts/ipad.ts verify",
    "ipad:install": "node --import tsx scripts/ipad.ts install",
    "browser:install": "playwright install chromium",
    "canvas": "node scripts/cli.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@tldraw/assets": "5.5.2",
    "@tldraw/sync": "5.5.2",
    "@tldraw/sync-core": "5.5.2",
    "@tldraw/tlschema": "5.5.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tldraw": "5.5.2",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.0.0",
    "playwright": "^1.58.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
